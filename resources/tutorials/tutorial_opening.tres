direction = "topleft"
wait = "move"
text = "As you can see, customers will always have requests. if you fulfill them, they’ll pay extra."
metadata/_custom_type_script = "uid://csamr37igbx17"

[sub_resource type="Resource" id="Resource_psg7k"]
script = ExtResource("2_0j6qw")
pos = Vector2(800, 500)
direction = "topleft"
wait = "move"
text = "Customers will still buy other types of potions, though. It’s all up to your recommendation."
metadata/_custom_type_script = "uid://csamr37igbx17"

[sub_resource type="Resource" id="Resource_grtyl"]
