[sub_resource type="Resource" id="Resource_p5mai"]
script = ExtResource("3_s77em")
speaker = "Mingming"
texture2 = ExtResource("4_jr6xt")
text = "Wow, looks like you chose to \"encounter\" someone... or something!"
metadata/_custom_type_script = "uid://dtxqdmfssbsvf"

[sub_resource type="Resource" id="Resource_pymg0"]
script = ExtResource("3_s77em")
speaker = "Mingming"
texture2 = ExtResource("5_b2vba")
text = "As the name suggests, you could run into any array of random happenings, good or bad. Take the opportunity to make some new friends!"
metadata/_custom_type_script = "uid://dtxqdmfssbsvf"

[sub_resource type="Resource" id="Resource_m6yex"]
script = ExtResource("3_s77em")
speaker = "Mingming"
texture2 = ExtResource("6_0513f")
text = "And the first person you'll encounter is..."
metadata/_custom_type_script = "uid://dtxqdmfssbsvf"

[sub_resource type="Resource" id="Resource_6sl1r"]
script = ExtResource("3_s77em")
speaker = "Mingming"
texture2 = ExtResource("5_b2vba")
text = "Me!"
metadata/_custom_type_script = "uid://dtxqdmfssbsvf"

[sub_resource type="Resource" id="Resource_dje1e"]
script = ExtResource("3_s77em")
speaker = "Mingming"
texture2 = ExtResource("5_b2vba")
text = "Hehe, didn't see that coming, did you?"
metadata/_custom_type_script = "uid://dtxqdmfssbsvf"

[sub_resource type="Resource" id="Resource_ttgsk"]
script = ExtResource("3_s77em")
speaker = "Mingming"
texture2 = ExtResource("7_4uyxw")
text = "Hmm... what should I do to make your first experience extra special..."
metadata/_custom_type_script = "uid://dtxqdmfssbsvf"

[sub_resource type="Resource" id="Resource_lywhn"]
script = ExtResource("3_s77em")
speaker = "Mingming"
texture2 = ExtResource("7_4uyxw")
text = "Maybe I could take away some of your money, or squander some of your ingredients..."
metadata/_custom_type_script = "uid://dtxqdmfssbsvf"

[sub_resource type="Resource" id="Resource_immgr"]
script = ExtResource("3_s77em")
speaker = "Mingming"
texture2 = ExtResource("5_b2vba")
text = "Haha, just kidding! Since you're new, I'll help you out a bit instead."
metadata/_custom_type_script = "uid://dtxqdmfssbsvf"

[sub_resource type="Resource" id="Resource_niyur"]
script = ExtResource("3_s77em")
speaker = "Mingming"
texture2 = ExtResource("4_jr6xt")
text = "Here's a free recipe."
metadata/_custom_type_script = "uid://dtxqdmfssbsvf"

[sub_resource type="Resource" id="Resource_joo5l"]
script = ExtResource("3_s77em")
texture2 = ExtResource("4_jr6xt")
text = "You got the recipe for a Draft Potion."
metadata/_custom_type_script = "uid://dtxqdmfssbsvf"

[sub_resource type="Resource" id="Resource_o0bj5"]
script = ExtResource("3_s77em")
speaker = "Mingming"
texture2 = ExtResource("8_ikyqw")
text = "By the way, you can always check your inventory during events by pressing the button up there."
metadata/_custom_type_script = "uid://dtxqdmfssbsvf"

[sub_resource type="Resource" id="Resource_bdaym"]
script = ExtResource("3_s77em")
speaker = "Mingming"
texture2 = ExtResource("4_jr6xt")
text = "Okay, bye now! Good luck!"
metadata/_custom_type_script = "uid://dtxqdmfssbsvf"

