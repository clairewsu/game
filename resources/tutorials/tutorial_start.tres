[sub_resource type="Resource" id="Resource_24dkh"]
script = ExtResource("2_31fng")
pos = Vector2(100, 100)
direction = "bottomright"
wait = "move"
text = "There's more to being a shopkeeper than that. To sell potions, you've gotta make them first!"
