metadata/_custom_type_script = "uid://csamr37igbx17"

[sub_resource type="Resource" id="Resource_vfes3"]
script = ExtResource("2_31fng")
pos = Vector2(830, 350)
direction = "topleft"
wait = "move"
text = "You can only make a potion if you have its [b]recipe[/b]. You can see their price, ingredient cost, and effects right here!"
metadata/_custom_type_script = "uid://csamr37igbx17"

[sub_resource type="Resource" id="Resource_aadeu"]
script = ExtResource("2_31fng")
pos = Vector2(830, 350)
direction = "topleft"
wait = "move"
text = "There are four different types of potions: growth[img=30]res://art/green.PNG[/img], gold[img=30]res://art/gold.PNG[/img], magic[img=30]res://art/blue.PNG[/img], and mind[img=30]res://art/swirl.PNG[/img]. You can tell a potion’s type based on its label."
metadata/_custom_type_script = "uid://csamr37igbx17"

[sub_resource type="Resource" id="Resource_1wkrw"]
script = ExtResource("2_31fng")
pos = Vector2(830, 350)
direction = "topleft"
wait = "move"
text = "Customers might ask for any type of potion, so it’s a good idea to always have a variety on hand."
metadata/_custom_type_script = "uid://csamr37igbx17"

[sub_resource type="Resource" id="Resource_2jxxo"]
script = ExtResource("2_31fng")
pos = Vector2(830, 350)
direction = "topleft"
wait = "move"
text = "Oh, but to make potions, you have to have the ingredients first. You can get ingredients through [b]events[/b]."
