steps = Array[ExtResource("3_vk187")]([SubResource("Resource_dty6p"), SubResource("Resource_ul2pc"), SubResource("Resource_2i3or"), SubResource("Resource_lvfrv"), SubResource("Resource_lxqbl"), SubResource("Resource_kenfm"), SubResource("Resource_7pf3b"), SubResource("Resource_37cwu"), SubResource("Resource_td1tk"), SubResource("Resource_uxdh1"), SubResource("Resource_kdube"), SubResource("Resource_0q5lx"), SubResource("Resource_4rh80"), SubResource("Resource_4863f"), SubResource("Resource_kdgye"), SubResource("Resource_226qs"), SubResource("Resource_20ns4"), SubResource("Resource_d41gx"), SubResource("Resource_poi20"), SubResource("Resource_h2810")])
